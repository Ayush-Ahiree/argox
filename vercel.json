{
  "buildCommand": "cd frontend && npm install && npm run build && cd ../blog && npm install && npm run build && rm -rf ../frontend/dist/blog && cp -r dist ../frontend/dist/blog",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/blogs",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blogs/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/:page(pricing|terms|refunds)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/(login|signup)",
      "destination": "/index.html"
    }
  ]
}
